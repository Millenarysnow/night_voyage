**/.idea
**/.DS_Store
**/.godot

# CMake / 原生编译缓存与本机二进制；保留 .gdextension 和 Godot 的 .uid 文件。
/cmake-build-*/
/build/
/native/*/bin/
/addons/night_voyageExt/bin/windows/
/addons/night_voyageExt/bin/linux/
/addons/night_voyageExt/bin/macos/
/addons/night_voyageExt/bin/android/
/addons/night_voyageExt/bin/ios/
/addons/night_voyageExt/bin/web/

# NV Timeline 的本机编译产物；源码和 .gdextension 配置进入版本控制，平台 DLL
# 由本机 CMake 重新生成，避免把 20MB 级调试库写入提交。
/addons/nv_timeline/bin/
/addons/nv_timeline/native/bin/
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.dll.a
*.import

# 由现有 CMake 下载的 IDE 插件及本地验收输出。
/addons/rider-plugin/
/artifacts/
